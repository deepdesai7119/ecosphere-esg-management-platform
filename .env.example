# ================= VerdantIQ environment =================
# Copy to `.env` and fill in. Never commit real secrets.

# MySQL connection string.
#  - Local Homebrew MySQL:  mysql://verdantiq:verdantiq@127.0.0.1:3306/verdantiq
#  - Docker Compose (this repo): mysql://verdantiq:verdantiq@127.0.0.1:3306/verdantiq
DATABASE_URL="mysql://verdantiq:verdantiq@127.0.0.1:3306/verdantiq"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Secret protecting cron/job routes (e.g. overdue compliance sweep).
# Generate with: openssl rand -hex 16
CRON_SECRET=""

# Optional transactional email via Resend.
# When RESEND_API_KEY is empty, emails are logged to the server console
# instead of being sent (in-app notifications still work fully).
RESEND_API_KEY=""
EMAIL_FROM="VerdantIQ <no-reply@verdantiq.demo>"

# Max upload size (MB) for proof / policy documents.
UPLOAD_MAX_SIZE_MB=5
